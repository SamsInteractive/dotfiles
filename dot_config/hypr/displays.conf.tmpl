{{- if eq .chezmoi.hostname "SamsPC" -}}
# ---------- Desktop Configs ----------

# ------- Display Settings -------
monitorv2 {
output = DP-1
mode = 3840x2160@240
position = 0x0
scale = 1.5
bitdepth = 10
supports_wide_color = 1
supports_hdr = 1
sdr_min_luminance = 0.005
sdr_max_luminance = 200
sdrbrightness = 1.1
min_luminance = 0.0
max_luminance = 1016
max_avg_luminance = 412
}

monitor=DP-2, 3440x1440@144, auto-right, 1
monitor=HDMI-A-1, 1920x1080@60, auto-right, 1
monitor= , preferred, auto, 1

# ----- Assign Workspaces -----
workspace=1, monitor:DP-1
workspace=2, monitor:DP-1
workspace=3, monitor:DP-1
workspace=4, monitor:DP-1
workspace=5, monitor:DP-1

workspace=6, monitor:DP-2
workspace=7, monitor:DP-2
workspace=8, monitor:DP-2
workspace=9, monitor:DP-2

workspace=10, monitor:HDMI-A-1


# ----- XWayland Scaling -----
xwayland {
    force_zero_scaling = true
}


# ----- Scaling Corrections -----
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24
env = GDK_SCALE,1

{{- else if eq .chezmoi.hostname "SamsLaptop" -}}
# ---------- Laptop Configs ----------

# ------- Display Settings -------
monitor=eDP-1, 2880x1800@120, 0x0, 2, bitdepth, 10, cm, hdr
monitor= , preferred, auto-right, 1

# ----- Assign Workspaces -----
workspace=1, monitor:eDP-1
workspace=2, monitor:eDP-1
workspace=3, monitor:eDP-1
workspace=4, monitor:eDP-1
workspace=5, monitor:eDP-1


# ----- XWayland Scaling -----
xwayland {
    force_zero_scaling = true
}


# ----- Scaling Corrections -----
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24
env = GDK_SCALE,2

{{- else -}}
# Modify file below directly for display changes
source = ~/.config/hypr/displays.local.conf
{{- end -}}
